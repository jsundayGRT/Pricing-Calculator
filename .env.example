# Microsoft Entra ID (Azure AD) app registration — Web platform
# Redirect URI: https://YOUR_DOMAIN/api/auth/callback
# Local:       http://localhost:3000/api/auth/callback
AZURE_AD_TENANT_ID=
AZURE_AD_CLIENT_ID=
AZURE_AD_CLIENT_SECRET=

# Random secret for signing session cookies (32+ chars)
# Generate: openssl rand -base64 48
SESSION_SECRET=

# Optional: restrict sign-in to this email domain
# AZURE_AD_ALLOWED_EMAIL_DOMAIN=

# Optional: comma-separated admin emails for Executive summary
# (jared.sunday@guardrail.tech, susan.landaluce@guardrail.tech, and dena.lumbang@guardrail.tech are always included)
# ADMIN_EMAILS=other.exec@guardrail.tech

# Optional: public site origin
# APP_BASE_URL=https://your-app.vercel.app

# HubSpot integration (see README → HubSpot integration)
# Private app token: server only, never sent to the browser
# HUBSPOT_TOKEN=
# HUBSPOT_QUOTE_TEMPLATE_ID=
# HUBSPOT_QUOTE_EXPIRY_DAYS=30
# Optional: defaults to the pipeline labelled "Guardrail Sales Pipeline"
# HUBSPOT_PIPELINE_ID=
# Optional: 1 = log HubSpot payloads instead of calling HubSpot
# HUBSPOT_DRY_RUN=1

# Storage (see README → Storage). Added by Vercel → Storage → Upstash for Redis.
# KV_REST_API_URL=
# KV_REST_API_TOKEN=

# Slack Deal Review approvals (see README → Slack Deal Review approvals)
# SLACK_BOT_TOKEN=
# SLACK_SIGNING_SECRET=
# SLACK_DEAL_REVIEW_CHANNEL=
